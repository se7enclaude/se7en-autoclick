<Window x:Class="Se7enAutoclick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Se7enAutoclick.Controls"
        xmlns:vm="clr-namespace:Se7enAutoclick.ViewModels"
        xmlns:core="clr-namespace:Se7enAutoclick.Core;assembly=Se7enAutoclick.Core"
        Title="se7en Autoclick" Width="1180" Height="800" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        FontFamily="{StaticResource FontSans}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ScreenHead" TargetType="DockPanel">
            <Setter Property="Margin" Value="2,4,0,16" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style TargetType="c:ValueBar">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Tone" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock" BasedOn="{StaticResource MicroText}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WellBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        </Style>
        <Style x:Key="Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="110" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        </Style>
        <Style x:Key="BigReadout" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
        </Style>
        <!-- liste des macros -->
        <Style x:Key="MacroList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Style="{StaticResource Raised}" Padding="12,10" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource InverseBrush}" />
                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="b" Property="Effect" Value="{DynamicResource SelectedGlow}" />
                                            <Setter TargetName="b" Property="TextElement.Foreground" Value="{DynamicResource TextInverseBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,0,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Barre du haut ===== -->
            <DockPanel Grid.ColumnSpan="3" Margin="6,0,0,0">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock c:Ui.Caps="se7en autoclick" FontFamily="{StaticResource FontDisplay}" FontSize="19" Foreground="{DynamicResource TextStrongBrush}" />
                    <TextBlock Text="autoclic et macros pour farmer" Style="{StaticResource CaptionText}" Margin="1,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Busy}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="#1A3DFF8C" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                                        <Setter Property="Background" Value="#1AFF3D33" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" FontFamily="{StaticResource FontMono}" />
                    </Border>
                    <Button Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE71A;" Click="StopAll_Click" Margin="0,0,6,0"
                            Content="{Binding StopButtonText}" ToolTip="Tout arrêter (aussi : Échap maintenu 1 seconde)" />
                    <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="8,0,6,0" />
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE921;" FontSize="11" Click="Minimize_Click" ToolTip="Réduire" />
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE922;" FontSize="11" Click="Maximize_Click" ToolTip="Agrandir" />
                    <Button Style="{StaticResource GhostIconButton}" Content="&#xE8BB;" FontSize="11" Click="Close_Click" ToolTip="Fermer" />
                </StackPanel>
                <Border />
            </DockPanel>

            <!-- ===== Rail ===== -->
            <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0,12">
                <DockPanel>
                    <RadioButton x:Name="TabSettings" DockPanel.Dock="Bottom" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE713;" Content="Réglages"
                                 GroupName="Nav" Checked="Tab_Checked" HorizontalAlignment="Center" ToolTip="Raccourcis et options" />
                    <StackPanel HorizontalAlignment="Center">
                        <RadioButton x:Name="TabClicker" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE962;" Content="Autoclic" GroupName="Nav" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabMacros" Style="{StaticResource RailItem}" c:Ui.Icon="&#xE7C8;" Content="Macros" GroupName="Nav" Checked="Tab_Checked" ToolTip="Enregistrer et rejouer en boucle" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Grid.Column="2">

                <!-- ========== AUTOCLIC ========== -->
                <DockPanel x:Name="PageClicker">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MeasuredCps}" Style="{StaticResource BigReadout}" HorizontalAlignment="Right" />
                                <TextBlock c:Ui.Caps="clics / s" Style="{StaticResource MicroText}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ClickCount}" Style="{StaticResource BigReadout}" HorizontalAlignment="Right" />
                                <TextBlock c:Ui.Caps="clics" Style="{StaticResource MicroText}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <Button MinWidth="190" Height="44" Click="ToggleClicker_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="c:Ui.Icon" Value="&#xE768;" />
                                        <Setter Property="Content" Value="Démarrer" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClickerRunning}" Value="True">
                                                <Setter Property="c:Ui.Icon" Value="&#xE71A;" />
                                                <Setter Property="Content" Value="Arrêter" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="AUTOCLIC" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{Binding ClickerKey}" Style="{StaticResource KeyCapText}" /></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0">
                                <Run Text="Règle tout ici, puis appuie sur" /> <Run Text="{Binding ClickerKey, Mode=OneWay}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextStrongBrush}" />
                                <Run Text="dans ton jeu pour lancer ou arrêter les clics." />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Vitesse" c:Ui.Subtitle="Jusqu'à 1 000 clics par seconde, réglés au millième" Margin="0,0,0,10">
                                    <StackPanel>
                                        <c:ValueBar Label="Clics par seconde" Minimum="1" Maximum="100" Tick="1" Value="{Binding Cps}" Format="{}{0:0.##} / s" />
                                        <DockPanel Style="{StaticResource Row}" Margin="0,4,0,14">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBox Style="{StaticResource Number}" Text="{Binding IntervalMs, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}}" />
                                                <TextBlock Text="ms" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Intervalle exact" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="Temps entre deux clics. Ex : 1 = 1 000 clics/s, 60000 = 1 clic par minute." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <c:ValueBar Label="Aléatoire (plus humain)" Minimum="0" Maximum="50" Tick="1" Value="{Binding Click.RandomPercent}" Format="± {0:0} %" />
                                        <c:ValueBar Label="Durée d'appui (0 = auto)" Minimum="0" Maximum="300" Tick="1" Value="{Binding Click.HoldMs}" Format="{}{0:0} ms" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Quoi cliquer" c:Ui.Subtitle="Un bouton de la souris, ou une touche du clavier à marteler" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Souris" GroupName="Target" IsChecked="{Binding UseKey, Converter={x:Static vm:Converters.Not}}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Touche du clavier" GroupName="Target" IsChecked="{Binding UseKey}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Visibility="{Binding UseKey, Converter={x:Static vm:Converters.InverseBoolToVisibility}}">
                                            <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource SegItem}" Content="Gauche" GroupName="Btn" IsChecked="{Binding ClickButton, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Left}" />
                                                    <RadioButton Style="{StaticResource SegItem}" Content="Droit" GroupName="Btn" IsChecked="{Binding ClickButton, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Right}" />
                                                    <RadioButton Style="{StaticResource SegItem}" Content="Molette" GroupName="Btn" IsChecked="{Binding ClickButton, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Middle}" />
                                                    <RadioButton Style="{StaticResource SegItem}" Content="Bouton 4" GroupName="Btn" IsChecked="{Binding ClickButton, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=X1}" />
                                                    <RadioButton Style="{StaticResource SegItem}" Content="Bouton 5" GroupName="Btn" IsChecked="{Binding ClickButton, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=X2}" />
                                                </StackPanel>
                                            </Border>
                                            <DockPanel Style="{StaticResource Row}" Margin="0">
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Click.DoubleClick}" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <TextBlock Text="Double-clic" Style="{StaticResource StrongText}" />
                                                    <TextBlock Text="Deux clics rapides à chaque fois." Style="{StaticResource CaptionText}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                        <DockPanel Visibility="{Binding UseKey, Converter={x:Static vm:Converters.BoolToVisibility}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE765;" Content="Changer" Click="CaptureClickKey_Click" Margin="0" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Touche :" Style="{StaticResource StrongText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <Border Style="{StaticResource KeyCap}"><TextBlock Text="{Binding ClickKeyText}" Style="{StaticResource KeyCapText}" /></Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Condition couleur" Margin="0,10,0,0"
                                                        c:Ui.Subtitle="Ne clique que quand un point de l'écran a (ou n'a plus) une couleur : un bouton « Collect » qui apparaît, une barre pleine…">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Toujours cliquer" GroupName="Cond" IsChecked="{Binding Condition.Mode, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Off}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Si la couleur est là" GroupName="Cond" IsChecked="{Binding Condition.Mode, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=WhenMatches}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Si elle n'y est plus" GroupName="Cond" IsChecked="{Binding Condition.Mode, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=WhenDifferent}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Visibility="{Binding Condition.Mode, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=WhenMatches|WhenDifferent}">
                                            <DockPanel Margin="0,0,0,10">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE7B7;" Content="Choisir le point" Click="PickConditionColor_Click" Margin="0" VerticalAlignment="Center" />
                                                <Border Width="22" Height="22" CornerRadius="4" Background="{Binding ConditionBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ConditionText}" Style="{StaticResource StrongText}" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <c:ValueBar Label="Tolérance" Minimum="0" Maximum="120" Tick="1" Value="{Binding Condition.Tolerance}" Format="± {0:0}" />
                                            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                       Text="Clique sur le point quand il a la bonne couleur : se7en Autoclick la retient. Monte la tolérance si la couleur bouge un peu (lumière, animation)." />
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Déclenchement" c:Ui.Subtitle="Comment ton raccourci lance les clics" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Marche / arrêt" GroupName="Trig" IsChecked="{Binding Click.Trigger, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Toggle}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Tant que je maintiens" GroupName="Trig" IsChecked="{Binding Click.Trigger, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Hold}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                                            <Run Text="Raccourci :" /> <Run Text="{Binding ClickerKey, Mode=OneWay}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextStrongBrush}" />
                                            <Run Text="· modifiable dans Réglages (touche, combinaison ou bouton de souris)." />
                                        </TextBlock>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Arrêt automatique" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Jamais" GroupName="Lim" IsChecked="{Binding Click.Limit, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Infinite}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Après N clics" GroupName="Lim" IsChecked="{Binding Click.Limit, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Count}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Après une durée" GroupName="Lim" IsChecked="{Binding Click.Limit, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Duration}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Click.Limit, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=Count}">
                                            <TextBox Style="{StaticResource Number}" Text="{Binding Click.Count, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="clics" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Click.Limit, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=Duration}">
                                            <TextBox Style="{StaticResource Number}" Text="{Binding Click.DurationSeconds, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="secondes" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Où cliquer" c:Ui.Subtitle="Sous le curseur, à un point fixe, ou à plusieurs points chacun leur tour">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Sous le curseur" GroupName="Pos" IsChecked="{Binding Click.Position, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Cursor}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Point fixe" GroupName="Pos" IsChecked="{Binding Click.Position, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Fixed}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Plusieurs points" GroupName="Pos" IsChecked="{Binding Click.Position, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Points}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Visibility="{Binding Click.Position, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=Fixed|Points}">
                                            <WrapPanel Margin="0,0,0,10">
                                                <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE7B7;" Content="Choisir à l'écran" Click="PickPoint_Click" Margin="0,0,6,6" />
                                                <Button Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE710;" Content="Ajouter un point" Click="AddPoint_Click" Margin="0,0,6,6"
                                                        Visibility="{Binding Click.Position, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=Points}" />
                                                <Button Style="{StaticResource SmallGhostButton}" Content="Effacer" Click="ClearPoints_Click" Margin="0,0,6,6" />
                                            </WrapPanel>
                                            <Border Style="{StaticResource Well}" Padding="12,8" MinHeight="40">
                                                <ItemsControl ItemsSource="{Binding Points}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource KeyCap}" Margin="0,2,6,2"><TextBlock Text="{Binding}" Style="{StaticResource KeyCapText}" /></Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ========== MACROS ========== -->
                <DockPanel x:Name="PageMacros" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button MinWidth="200" Height="44" Click="Record_Click" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="c:Ui.Icon" Value="&#xE7C8;" />
                                        <Setter Property="Content" Value="Enregistrer" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="c:Ui.Icon" Value="&#xE71A;" />
                                                <Setter Property="Content" Value="Arrêter l'enregistrement" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button MinWidth="190" Height="44" Click="Play_Click" IsEnabled="{Binding HasMacro}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="c:Ui.Icon" Value="&#xE8EE;" />
                                        <Setter Property="Content" Value="Lire en boucle" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="c:Ui.Icon" Value="&#xE71A;" />
                                                <Setter Property="Content" Value="Arrêter" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource RedBrush}" />
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MACROS" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <Border Style="{StaticResource KeyCap}" Margin="0,0,6,0"><TextBlock Style="{StaticResource KeyCapText}"><Run Text="{Binding RecordKey, Mode=OneWay}" /> <Run Text="enregistrer" Foreground="{DynamicResource TextTertiaryBrush}" /></TextBlock></Border>
                                <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyCapText}"><Run Text="{Binding PlayKey, Mode=OneWay}" /> <Run Text="lire" Foreground="{DynamicResource TextTertiaryBrush}" /></TextBlock></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Lance l'enregistrement, joue (touches, clics, caméra), arrête : la macro rejoue tout à l'identique, en boucle." />
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <!-- bibliothèque + étapes -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="230" /><RowDefinition Height="10" /><RowDefinition Height="1.6*" />
                            </Grid.RowDefinitions>
                            <HeaderedContentControl Style="{StaticResource Card}" Header="Mes macros">
                                <HeaderedContentControl.Tag>
                                    <Button Style="{StaticResource SmallGhostButton}" c:Ui.Icon="&#xE838;" Content="Dossier" Click="OpenFolder_Click" Margin="0" />
                                </HeaderedContentControl.Tag>
                                <DockPanel>
                                    <!-- enregistrement en cours -->
                                    <Border DockPanel.Dock="Top" Style="{StaticResource Well}" Padding="14,10" Margin="0,0,0,10"
                                            Visibility="{Binding IsRecording, Converter={x:Static vm:Converters.BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Led Round="True" Width="9" Height="9" Tone="{DynamicResource RedBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Style="{StaticResource StrongText}" VerticalAlignment="Center">
                                                <Run Text="Enregistrement" /> <Run Text="{Binding RecordTime, Mode=OneWay}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextStrongBrush}" />
                                                <Run Text="·" /> <Run Text="{Binding RecordEvents, Mode=OneWay}" FontFamily="{StaticResource FontMono}" /> <Run Text="gestes" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <!-- renommer -->
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallDangerButton}" Content="Supprimer" Click="DeleteMacro_Click" Margin="6,0,0,0" IsEnabled="{Binding HasMacro}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Dupliquer" Click="DuplicateMacro_Click" Margin="6,0,0,0" IsEnabled="{Binding HasMacro}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}" Content="Renommer" Click="RenameMacro_Click" Margin="6,0,0,0" IsEnabled="{Binding HasMacro}" />
                                        <TextBox x:Name="RenameBox" KeyDown="RenameBox_KeyDown" ToolTip="Nouveau nom, puis Entrée" />
                                    </DockPanel>
                                    <Grid>
                                        <ListBox Style="{StaticResource MacroList}" ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MacroItem}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontSemi}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource FontMono}" FontSize="11.5" Opacity="0.7" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="Aucune macro pour l'instant. Clique sur « Enregistrer » ou appuie sur ton raccourci dans le jeu."
                                                   Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360"
                                                   Visibility="{Binding HasMacro, Converter={x:Static vm:Converters.InverseBoolToVisibility}}" />
                                    </Grid>
                                </DockPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Grid.Row="2" Style="{StaticResource Card}" Header="Étapes"
                                                    c:Ui.Subtitle="Choisis une étape pour la retoucher. Les mouvements de souris suivent leur étape.">
                                <HeaderedContentControl.Tag>
                                    <Button Style="{StaticResource SmallGhostButton}" c:Ui.Icon="&#xE7A7;" Content="Annuler" Click="Undo_Click" Margin="0" IsEnabled="{Binding CanUndo}" />
                                </HeaderedContentControl.Tag>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <WrapPanel>
                                            <Button Style="{StaticResource SmallSecondaryButton}" Content="Commencer ici" Click="TrimBefore_Click" Margin="0,0,6,6" IsEnabled="{Binding HasStep}"
                                                    ToolTip="Coupe tout ce qui est avant cette étape" />
                                            <Button Style="{StaticResource SmallSecondaryButton}" Content="Finir ici" Click="TrimAfter_Click" Margin="0,0,6,6" IsEnabled="{Binding HasStep}"
                                                    ToolTip="Coupe tout ce qui est après cette étape" />
                                            <Button Style="{StaticResource SmallDangerButton}" Content="Supprimer l'étape" Click="DeleteStep_Click" Margin="0,0,6,6" IsEnabled="{Binding HasStep}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <Button Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE7B7;" Content="Attendre une couleur" Click="WaitColor_Click" Margin="0,0,6,6" IsEnabled="{Binding HasMacro}"
                                                    ToolTip="Avant l'étape choisie : attend qu'un point de l'écran prenne une couleur" />
                                            <Button Style="{StaticResource SmallGhostButton}" Content="… qu'elle disparaisse" Click="WaitColorGone_Click" Margin="0,0,6,6" IsEnabled="{Binding HasMacro}"
                                                    ToolTip="Avant l'étape choisie : attend qu'un point de l'écran perde sa couleur" />
                                            <StackPanel Orientation="Horizontal" Margin="6,0,0,6" IsEnabled="{Binding HasStep}">
                                                <TextBlock Text="Délai avant" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Number}" Width="90" Text="{Binding StepDelay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0}}" KeyDown="Number_KeyDown" />
                                                <TextBlock Text="ms" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border Style="{StaticResource Well}" Padding="6,6">
                                        <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedIndex="{Binding SelectedStep}" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource FontMono}" FontSize="12"
                                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="6,3" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource InverseBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextInverseBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Border>
                                </DockPanel>
                            </HeaderedContentControl>
                        </Grid>

                        <!-- lecture -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,10">
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Lecture" Margin="0,0,0,10">
                                    <HeaderedContentControl.Tag>
                                        <TextBlock Style="{StaticResource MetaText}"><Run Text="BOUCLE" /> <Run Text="{Binding PlayLoop, Mode=OneWay}" Foreground="{DynamicResource TextStrongBrush}" /></TextBlock>
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <ProgressBar Height="3" Minimum="0" Maximum="1" Value="{Binding PlayProgress, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"
                                                     Background="{DynamicResource MeterOffBrush}" BorderThickness="0" Margin="0,0,0,14" />
                                        <TextBlock Text="Lire" Style="{StaticResource Field}" />
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="La macro choisie" GroupName="Src" IsChecked="{Binding Play.UseChain, Converter={x:Static vm:Converters.Not}}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="L'enchaînement" GroupName="Src" IsChecked="{Binding Play.UseChain}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Répéter" Style="{StaticResource Field}" />
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="À l'infini" GroupName="Loop" IsChecked="{Binding Play.Loop, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Infinite}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="N fois" GroupName="Loop" IsChecked="{Binding Play.Loop, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Count}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Pendant" GroupName="Loop" IsChecked="{Binding Play.Loop, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Duration}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding Play.Loop, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=Count}">
                                            <TextBox Style="{StaticResource Number}" Text="{Binding Play.LoopCount, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="fois" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Visibility="{Binding Play.Loop, Converter={x:Static vm:Converters.EnumToVisibility}, ConverterParameter=Duration}">
                                            <TextBox Style="{StaticResource Number}" Text="{Binding Play.LoopMinutes, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="minutes" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <c:ValueBar Label="Vitesse" Minimum="0.25" Maximum="4" Origin="1" Tick="0.05" Value="{Binding Play.Speed}" Format="× {0:0.##}" />
                                        <c:ValueBar Label="Pause entre deux boucles" Minimum="0" Maximum="10000" Tick="100" Value="{Binding Play.PauseMs}" Format="{}{0:0} ms" />
                                        <c:ValueBar Label="Aléatoire (plus humain)" Minimum="0" Maximum="30" Tick="1" Value="{Binding Play.RandomPercent}" Format="± {0:0} %" />
                                        <c:ValueBar Label="Compte à rebours" Minimum="0" Maximum="10" Tick="1" Value="{Binding Play.CountdownSeconds}" Format="{}{0:0} s" />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Enchaînement" Margin="0,0,0,10"
                                                        c:Ui.Subtitle="Plusieurs macros à la suite, chacune répétée, le tout en boucle. Ex : aller au spot ×1, farmer ×20, vendre ×1.">
                                    <HeaderedContentControl.Tag>
                                        <Button Style="{StaticResource SmallPrimaryButton}" c:Ui.Icon="&#xE710;" Content="Ajouter" Click="AddToChain_Click" Margin="0" IsEnabled="{Binding HasMacro}"
                                                ToolTip="Ajoute la macro choisie à la fin" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <TextBlock Text="Choisis une macro à gauche, puis « Ajouter »." Style="{StaticResource CaptionText}" Margin="0,0,0,6"
                                                   Visibility="{Binding Chain.Count, Converter={x:Static vm:Converters.ZeroToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding Chain}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ChainItem}">
                                                    <Border Style="{StaticResource Well}" Padding="10,6" Margin="0,0,0,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE711;" FontSize="10" Click="RemoveFromChain_Click" Tag="{Binding}" ToolTip="Retirer" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE70D;" FontSize="10" Click="ChainDown_Click" Tag="{Binding}" ToolTip="Descendre" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostIconButton}" Content="&#xE70E;" FontSize="10" Click="ChainUp_Click" Tag="{Binding}" ToolTip="Monter" />
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0">
                                                                <TextBlock Text="×" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBox Style="{StaticResource Number}" Width="64" Text="{Binding Repeat, UpdateSourceTrigger=LostFocus}" KeyDown="Number_KeyDown" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource StrongText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Souris" c:Ui.Subtitle="Comment rejouer les mouvements" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Jeu 3D (Roblox)" GroupName="Mouse" IsChecked="{Binding Play.Mouse, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Relative}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Positions à l'écran" GroupName="Mouse" IsChecked="{Binding Play.Mouse, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Screen}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Text="« Jeu 3D » rejoue les mouvements comme ta vraie souris : la caméra tourne pareil. « Positions à l'écran » replace le curseur exactement : pour les menus et les jeux en 2D." />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Anti-AFK Roblox" Margin="0,0,0,10"
                                                        c:Ui.Subtitle="Roblox t'éjecte après 20 minutes sans rien faire. Toutes les X minutes, un petit geste est envoyé à Roblox, même s'il est derrière une autre fenêtre.">
                                    <HeaderedContentControl.Tag>
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Afk.Enabled}" />
                                    </HeaderedContentControl.Tag>
                                    <StackPanel>
                                        <Border Style="{StaticResource SegBar}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource SegItem}" Content="Saut" GroupName="Afk" IsChecked="{Binding Afk.Action, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Jump}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Petit pas" GroupName="Afk" IsChecked="{Binding Afk.Action, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Step}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Caméra" GroupName="Afk" IsChecked="{Binding Afk.Action, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Camera}" />
                                                <RadioButton Style="{StaticResource SegItem}" Content="Clic" GroupName="Afk" IsChecked="{Binding Afk.Action, Converter={x:Static vm:Converters.EnumIs}, ConverterParameter=Click}" />
                                            </StackPanel>
                                        </Border>
                                        <c:ValueBar Label="Toutes les" Minimum="1" Maximum="19" Tick="1" Value="{Binding Afk.Minutes}" Format="{}{0:0} min" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}" Content="Tester" Click="TestAfk_Click" Margin="0" />
                                            <TextBlock Text="{Binding AfkNext}" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Text="Le geste attend que tu ne tapes pas pour passer Roblox devant un quart de seconde, puis ta fenêtre revient. Rien n'est envoyé pendant qu'une macro ou l'autoclic tourne." />
                                    </StackPanel>
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Card}" Header="Sécurité">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Play.StopOnFocusChange}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Arrêter si je change de fenêtre" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="La macro ne tape jamais ailleurs que dans ton jeu." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                                            <Run Text="Arrêt d'urgence : maintiens" /> <Run Text="Échap" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextStrongBrush}" />
                                            <Run Text="1 seconde, ou" /> <Run Text="{Binding StopKey, Mode=OneWay}" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource TextStrongBrush}" /><Run Text="." />
                                        </TextBlock>
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- ========== RÉGLAGES ========== -->
                <DockPanel x:Name="PageSettings" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource ScreenHead}">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RÉGLAGES" Style="{StaticResource TitleText}" Margin="0,0,16,0" />
                                <TextBlock Text="{Binding Version}" Style="{StaticResource MetaText}" />
                            </StackPanel>
                            <TextBlock Text="Tes raccourcis et le comportement de l'appli." Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <HeaderedContentControl Style="{StaticResource Card}" Header="Raccourcis"
                                                    c:Ui.Subtitle="Clique sur « Changer » puis appuie sur une touche, une combinaison (Ctrl, Maj, Alt) ou un bouton de souris (molette, 4, 5). Échap annule.">
                                <HeaderedContentControl.Tag>
                                    <Button Style="{StaticResource SmallGhostButton}" Content="Par défaut" Click="ResetBindings_Click" Margin="0" />
                                </HeaderedContentControl.Tag>
                                <ItemsControl ItemsSource="{Binding Bindings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BindingItem}">
                                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostButton}" Content="Retirer" Click="ClearBinding_Click" Tag="{Binding}" Margin="6,0,0,0" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallSecondaryButton}" c:Ui.Icon="&#xE765;" Content="Changer" Click="CaptureBinding_Click" Tag="{Binding}" Margin="6,0,0,0" />
                                                    <Border DockPanel.Dock="Right" Margin="10,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource KeyCap}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Capturing}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Display}" Style="{StaticResource KeyCapText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StrongText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </HeaderedContentControl>

                            <StackPanel Grid.Column="2">
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Général" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ShowOverlay}" Click="Overlay_Click" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Pastille d'état par-dessus le jeu" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="Montre en haut de l'écran quand l'autoclic, l'enregistrement ou la lecture tourne." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Sounds}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Petits bips" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="Un bip aigu au départ, un grave à l'arrêt : pratique en plein jeu." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource Row}">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.MinimizeToTray}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Rester dans la zone de notification" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="Fermer la fenêtre garde les raccourcis actifs." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource Row}" Margin="0">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutostartEnabled}" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Démarrer avec Windows" Style="{StaticResource StrongText}" />
                                                <TextBlock Text="Lancé discrètement dans la zone de notification." Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Card}" Header="Conseils Roblox">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="• Lance l'enregistrement et la lecture avec tes raccourcis, depuis le jeu : la macro rejouera dans la bonne fenêtre." />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="• Une macro rejoue des gestes : repars toujours du même endroit, face à la même direction." />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Text="• Pour un trajet qui boucle, finis l'enregistrement là où tu l'as commencé." />
                                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                   Text="• Certains jeux Roblox interdisent les macros dans leurs règles : à toi de voir." />
                                    </StackPanel>
                                </HeaderedContentControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ===== Toast ===== -->
        <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" MaxWidth="460"
                Style="{StaticResource Raised}" Padding="16,12" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource PopShadow}">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="ToastText" Style="{StaticResource StrongText}" Foreground="{DynamicResource TextStrongBrush}" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
